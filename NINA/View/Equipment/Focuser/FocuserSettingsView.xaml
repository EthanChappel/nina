<UserControl x:Class="NINA.View.Equipment.FocuserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
             xmlns:local="clr-namespace:NINA.View.Equipment"
             xmlns:rules="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
             xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
             xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="Default">
                <TextBlock Text="{ns:Loc LblNone}" />
            </DataTemplate>
            <DataTemplate x:Key="Zwo">
                <StackPanel
                    VerticalAlignment="Top"
                    Grid.IsSharedSizeScope="True"
                    Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZWOLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoDeviceId}" />
                        <TextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxLength="8"
                            Text="{Binding FocuserAlias}">
                            <TextBox.ToolTip>
                                <ToolTip ToolTipService.ShowOnDisabled="False">
                                    <TextBlock Text="{ns:Loc LblZwoDeviceIdTooltip}" />
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZWOLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoSetMaxStep}" />
                        <TextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Text="{Binding TargetMaxStep}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZWOLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoReversed}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding Reversed}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZWOLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.ColumnSpan="2"
                            Width="200"
                            Height="25"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetPositionCommand}">
                            <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoResetZeroPosition}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="Oasis">
                <StackPanel
                    VerticalAlignment="Top"
                    Grid.IsSharedSizeScope="True"
                    Orientation="Vertical">
                    <Grid Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisDcPower}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            IsChecked="{Binding DcPower, FallbackValue=False, Mode=OneWay}"
                            IsEnabled="False"
                            Style="{StaticResource InvertedCheckmarkCheckbox}" />
                    </Grid>
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoDeviceId}" />
                        <TextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxLength="8"
                            Text="{Binding FocuserAlias}">
                            <TextBox.ToolTip>
                                <ToolTip ToolTipService.ShowOnDisabled="False">
                                    <TextBlock Text="{ns:Loc LblDeviceIdTooltip}" />
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoSetMaxStep}" />
                        <TextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Text="{Binding TargetMaxStep}" />
                    </Grid>
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoReversed}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding Reversed}" />
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblBeepOnStartup}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding BeepOnStartup}" />
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblBeepOnMove}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding BeepOnMove}" />
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblBluetooth}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding Bluetooth}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisHeating}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding Heating}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisHeatingTemperature}" />
                        <ninactrl:UnitTextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Unit="°C">
                            <TextBox.Text>
                                <Binding Path="HeatingTemperature">
                                    <Binding.ValidationRules>
                                        <rules:IntRangeRule>
                                            <rules:IntRangeRule.ValidRange>
                                                <rules:IntRangeChecker Maximum="40" Minimum="-40" />
                                            </rules:IntRangeRule.ValidRange>
                                        </rules:IntRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </ninactrl:UnitTextBox>
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisBoardHeating}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            IsChecked="{Binding BoardHeating, FallbackValue=False, Mode=OneWay}"
                            IsEnabled="False"
                            Style="{StaticResource InvertedCheckmarkCheckbox}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisHeatingPower}" />
                        <TextBlock
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Text="{Binding HeatingPower}" />
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisBoardTemperature}" />
                        <TextBlock
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Text="{Binding BoardTemperature}" />
                    </Grid>



                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisStallDetection}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding StallDetection}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisIsStalled}" />
                        <CheckBox
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            IsChecked="{Binding IsStalled, FallbackValue=False, Mode=OneWay}"
                            IsEnabled="False"
                            Style="{StaticResource InvertedCheckmarkCheckbox}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.ColumnSpan="2"
                            Width="200"
                            Height="25"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearStallCommand}">
                            <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisClearStall}" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding IsFocuserRose, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisUSBCapacity}" />
                        <ComboBox
                            Grid.Column="1"
                            Width="80"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding USBCapacities}"
                            SelectedIndex="{Binding USBCapacity}" />
                    </Grid>

                    <Grid Margin="0,6,0,6" Visibility="{Binding HasMotorSpeedControl, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisSpeed}" />
                        <ComboBox
                            Grid.Column="1"
                            Width="80"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding HasMotorSpeedControl}"
                            ItemsSource="{Binding MotorSpeeds}"
                            SelectedIndex="{Binding MotorSpeed}" />
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.ColumnSpan="2"
                            Width="200"
                            Height="25"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetPositionCommand}">
                            <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblZwoResetZeroPosition}" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisSyncPosition}" />
                        <TextBox
                            Grid.Column="1"
                            Width="75"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left">
                            <TextBox.Text>
                                <Binding Path="SyncPosition">
                                    <Binding.ValidationRules>
                                        <rules:GreaterZeroRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Grid>
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="OasisLabelColumn" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.ColumnSpan="2"
                            Width="200"
                            Height="25"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SyncToPositionCommand}">
                            <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblOasisSyncPosition}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="Failed">
                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Failed to load plugin data template" />
            </DataTemplate>
            <local:FocuserTemplateSelector
                x:Key="ContentSelector"
                Default="{StaticResource Default}"
                FailedToLoadTemplate="{StaticResource Failed}"
                Oasis="{StaticResource Oasis}"
                Postfix="{x:Static wpfutil:DataTemplatePostfix.FocuserSettings}"
                Zwo="{StaticResource Zwo}" />
        </Grid.Resources>
        <!--  Binding to Focuser.Focuser as the focuser is a decorated class and needs to bind to the internal Focuser instance  -->
        <ContentControl
            Content="{Binding}"
            ContentTemplateSelector="{StaticResource ContentSelector}"
            DataContext="{Binding Focuser.Focuser}" />
    </Grid>
</UserControl>
